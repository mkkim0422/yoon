# Streamlit Community Cloud 휴면(Zzzz) wake 후에도 업로드한 단가표가 유지되도록
# repo 에 자동 백업/복원하기 위한 설정.
#
# 1) 본 파일을 `.streamlit/secrets.toml` 로 복사한다.
# 2) GitHub Fine-grained PAT 발급 — Settings > Developer settings >
#    Personal access tokens > Fine-grained tokens.
#    - Repository access: 본 repo 1개만 선택
#    - Repository permissions > Contents: Read and write
# 3) Streamlit Community Cloud 배포 시에는 앱 페이지의
#    "App settings > Secrets" 에 동일 내용을 그대로 붙여넣는다.
#
# 설정이 없거나 누락되어도 앱은 정상 동작하며, 단지 휴면 wake 후 단가표가
# 사라질 수 있다.

[github]
token  = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
repo   = "owner/repo-name"
branch = "main"
